# environments/staging/terraform.tfvars.example
# ✅ Este arquivo É seguro para commitar — sem valores reais
# Copie para terraform.tfvars e preencha com seus valores

project_name = "meu-projeto"
environment  = "staging"
aws_region   = "us-east-1"
aws_profile  = "terraform-staging"
owner        = "seu-time"
cost_center  = "engineering"

vpc_cidr              = "10.1.0.0/16"
availability_zones    = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs   = ["10.1.1.0/24", "10.1.2.0/24", "10.1.3.0/24"]
private_subnet_cidrs  = ["10.1.10.0/24", "10.1.11.0/24", "10.1.12.0/24"]
database_subnet_cidrs = ["10.1.20.0/24", "10.1.21.0/24", "10.1.22.0/24"]

ec2_instance_type    = "t3.medium"
asg_min_size         = 2
asg_max_size         = 4
asg_desired_capacity = 2

rds_instance_class        = "db.t3.small"
rds_allocated_storage     = 50
rds_max_allocated_storage = 100
db_name                   = "appdb"
db_username               = "appuser"  # OBRIGATÓRIO: não use 'admin', 'root', 'dbadmin'

alert_emails = ["staging-alerts@empresa.com"]

create_cicd_role         = true
github_oidc_provider_arn = "arn:aws:iam::ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"
github_org               = "ruok-dev"
github_repo              = "terraform"
