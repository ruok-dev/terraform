# ── Terraform State (NUNCA no git) ───────────────────────────────────────────
*.tfstate
*.tfstate.*
*.tfstate.backup

# ── Terraform Diretório de trabalho ──────────────────────────────────────────
**/.terraform/

# IMPORTANTE: .terraform.lock.hcl DEVE ser commitado!
# Ele garante versões exatas dos providers em toda a equipe.
# NÃO adicione ao .gitignore. Veja: https://developer.hashicorp.com/terraform/language/files/dependency-lock

# ── Variáveis sensíveis (NUNCA no git) ───────────────────────────────────────
terraform.tfvars
*.tfvars
!*.tfvars.example   # exemplos sem segredos são ok

# ── Credenciais e segredos ────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
*.p12
*.pfx
credentials.json
secrets.json
*secret*
*password*
*passwd*

# ── Planos de execução (S4: plans locais contêm dados sensíveis do state) ────
*.tfplan
tfplan
plan.out
**/.plans/

# ── Overrides (arquivos locais de override) ───────────────────────────────────
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Logs e temporários ────────────────────────────────────────────────────────
*.log
crash.log
crash.*.log

# ── MacOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Python (checkov, etc.) ────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# ── Node (scripts JS) ────────────────────────────────────────────────────────
node_modules/
npm-debug.log*

# ── Relatórios de scan ────────────────────────────────────────────────────────
tfsec-report.*
checkov-report.*

# ── Backend config com dados reais (nunca commitar backends com account IDs) ──
*.tfbackend
